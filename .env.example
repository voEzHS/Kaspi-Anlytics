DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/kaspi_analytics
ANTHROPIC_API_KEY=sk-ant-...
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500,http://localhost:8080

# Whole-site protection — leave empty locally to skip login.
# In production (Render), set a real password to require login for everything.
ADMIN_PASSWORD=
BASIC_AUTH_USER=torgstore

# Optional view-only accounts (can browse the dashboard, cannot upload/delete
# data, change settings, or generate AI reports — they never see ADMIN_PASSWORD).
# Format: "user1:pass1,user2:pass2"
BASIC_AUTH_VIEWERS=
